---
export const prerender = true;

import { getAllArticles, getArticleBySlug } from '@logan/libsql-search';
import DocsHeader from '@/components/DocsHeader.astro';
import DocsSidebar from '@/components/DocsSidebar.astro';
import DocsTocWithErrorBoundary from '@/components/DocsTocWithErrorBoundary.tsx';
import DocsLayout from '@/layouts/DocsLayout.astro';
import { marked } from '@/lib/markdown';
import { SEARCH_TABLE_NAME } from '@/lib/searchConfig';
import { getTursoClient } from '@/lib/turso';
import type { Article } from '@/types/article';

// Generate static paths for all articles at build time
export async function getStaticPaths() {
  const client = getTursoClient();
  const allArticles = await getAllArticles(client, SEARCH_TABLE_NAME);

  return allArticles.map((article) => ({
    params: { slug: article.slug },
    props: { allArticles },
  }));
}

// Get the slug from the URL. Because this route is prerendered and
// getStaticPaths enumerates every valid slug, `slug` and `article` are
// guaranteed to be defined at build time — a missing one is a build-time
// invariant violation, not a runtime 404.
const { slug } = Astro.params;
const { allArticles } = Astro.props as { allArticles: Article[] };

if (!slug) {
  throw new Error('[...slug].astro reached without a slug param');
}

const client = getTursoClient();
const article = await getArticleBySlug(client, slug, SEARCH_TABLE_NAME);

if (!article) {
  throw new Error(`Article not found for prerendered slug: ${slug}`);
}

// Convert markdown to HTML
const htmlContent = await marked(article.content);

// Parse tags
const tags = article.tags;
---

<DocsLayout title={article.title} description={article.title}>
  <DocsHeader />

  <div class="flex">
    <DocsSidebar articles={allArticles} />

    <main class="flex-1 lg:pl-64 xl:pr-64 min-w-0 relative z-10">
      <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
        <article class="prose prose-neutral dark:prose-invert max-w-none overflow-x-auto relative">
          <header class="mb-8 pb-6 border-b border-border">
            <h1 class="text-4xl font-bold tracking-tight text-balance mb-4">{article.title}</h1>
            {tags.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {tags.map((tag: string) => (
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-muted text-muted-foreground">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </header>

          <div class="article-content" set:html={htmlContent} />

          <footer class="mt-12 pt-6 border-t border-border">
            <p class="text-sm text-muted-foreground">
              Last updated: {new Date(article.updated_at).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </p>
          </footer>
        </article>
      </div>
    </main>

    <DocsTocWithErrorBoundary client:idle />
  </div>
</DocsLayout>

<style>
  /* Article content styling */
  .article-content {
    line-height: 1.75;
    color: var(--foreground);
  }

  .article-content :global(h1),
  .article-content :global(h2),
  .article-content :global(h3),
  .article-content :global(h4),
  .article-content :global(h5),
  .article-content :global(h6) {
    color: var(--foreground);
    font-weight: 700;
    line-height: 1.3;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .article-content :global(h1) {
    font-size: 2.25rem;
  }

  .article-content :global(h2) {
    font-size: 1.875rem;
    scroll-margin-top: 5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    margin-top: 3rem;
  }

  .article-content :global(h3) {
    font-size: 1.5rem;
    scroll-margin-top: 5rem;
  }

  .article-content :global(h4) {
    font-size: 1.25rem;
  }

  .article-content :global(p) {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
    padding-left: 1.75rem;
  }

  .article-content :global(ul) {
    list-style-type: disc;
  }

  .article-content :global(ol) {
    list-style-type: decimal;
  }

  .article-content :global(li) {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .article-content :global(li::marker) {
    color: var(--muted-foreground);
  }

  .article-content :global(strong) {
    color: var(--foreground);
    font-weight: 600;
  }

  .article-content :global(pre) {
    background: var(--muted);
    color: var(--foreground);
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    border: 1px solid var(--border);
  }

  .article-content :global(code) {
    background: var(--muted);
    color: var(--foreground);
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
    font-family: ui-monospace, 'Monaco', 'Courier New', monospace;
    border: 1px solid var(--border);
  }

  .article-content :global(pre code) {
    background: transparent;
    padding: 0;
    border: none;
    font-size: 0.875rem;
  }

  .article-content :global(.code-block) {
    position: relative;
    margin: 1.5rem 0;
  }

  .article-content :global(.code-block pre) {
    margin: 0;
  }

  /* Shiki emits classes, not inline styles, so the palette resolves here from
     the same theme variables the rest of the page uses. */
  .article-content :global(.sh-text) {
    color: var(--foreground);
  }
  .article-content :global(.sh-comment) {
    color: var(--syntax-comment);
  }
  .article-content :global(.sh-keyword) {
    color: var(--syntax-keyword);
  }
  .article-content :global(.sh-string) {
    color: var(--syntax-string);
  }
  .article-content :global(.sh-string-expression) {
    color: var(--syntax-string-expression);
  }
  .article-content :global(.sh-constant) {
    color: var(--syntax-constant);
  }
  .article-content :global(.sh-function) {
    color: var(--syntax-function);
  }
  .article-content :global(.sh-parameter) {
    color: var(--syntax-parameter);
  }
  .article-content :global(.sh-punctuation) {
    color: var(--syntax-punctuation);
  }
  .article-content :global(.sh-link) {
    color: var(--syntax-link);
  }
  .article-content :global(.sh-inserted) {
    color: var(--syntax-inserted);
  }
  .article-content :global(.sh-deleted) {
    color: var(--syntax-deleted);
  }
  .article-content :global(.sh-changed) {
    color: var(--syntax-changed);
  }
  .article-content :global(.sh-italic) {
    font-style: italic;
  }
  .article-content :global(.sh-bold) {
    font-weight: 700;
  }
  .article-content :global(.sh-underline) {
    text-decoration: underline;
  }

  .article-content :global(.code-copy) {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.25rem 0.6rem;
    font-size: 0.75rem;
    font-family: inherit;
    line-height: 1.4;
    color: var(--muted-foreground);
    background: var(--secondary);
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    opacity: 0.55;
    transition: opacity 0.15s ease, color 0.15s ease;
  }

  .article-content :global(.code-block:hover .code-copy),
  .article-content :global(.code-copy:focus-visible),
  .article-content :global(.code-copy[data-state]) {
    opacity: 1;
  }

  .article-content :global(.code-copy[data-state='copied']) {
    color: var(--primary);
  }

  .article-content :global(.code-copy[data-state='failed']) {
    color: var(--destructive-foreground);
    background: var(--destructive);
  }

  .article-content :global(a) {
    color: var(--primary);
    text-decoration: underline;
    text-decoration-color: var(--primary);
    text-decoration-thickness: 2px;
    text-underline-offset: 2px;
    font-weight: 500;
    transition: all 0.2s;
  }

  .article-content :global(a:hover) {
    text-decoration-thickness: 3px;
    opacity: 0.8;
  }

  .article-content :global(blockquote) {
    border-left: 4px solid var(--border);
    padding-left: 1rem;
    font-style: italic;
    color: var(--muted-foreground);
    margin: 1.5rem 0;
  }

  .article-content :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 3rem 0;
  }

  .article-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
    margin: 2rem 0;
  }

  .article-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
  }

  .article-content :global(th),
  .article-content :global(td) {
    padding: 0.75rem;
    border: 1px solid var(--border);
    text-align: left;
  }

  .article-content :global(th) {
    background: var(--muted);
    font-weight: 600;
  }
</style>

<script>
  // The button is injected rather than server-rendered so that a page without a
  // usable Clipboard API (any non-secure context) shows no button at all rather
  // than one that does nothing when pressed.
  const clipboard = navigator.clipboard;

  if (clipboard) {
    const blocks = document.querySelectorAll<HTMLElement>(
      '.article-content .code-block',
    );

    for (const block of blocks) {
      const code = block.querySelector('pre code');
      if (!code) continue;

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'code-copy';
      button.textContent = 'Copy';
      // Several buttons per page would otherwise all be named just "Copy".
      const language = code.className.replace(/^language-/, '');
      button.setAttribute(
        'aria-label',
        language ? `Copy ${language} code` : 'Copy code',
      );
      // The label carries the result, so announce it when it changes.
      button.setAttribute('aria-live', 'polite');

      let resetTimer = 0;
      button.addEventListener('click', async () => {
        try {
          await clipboard.writeText(code.textContent ?? '');
          button.textContent = 'Copied';
          button.dataset.state = 'copied';
        } catch {
          button.textContent = 'Copy failed';
          button.dataset.state = 'failed';
        }
        window.clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => {
          button.textContent = 'Copy';
          delete button.dataset.state;
        }, 2000);
      });

      block.appendChild(button);
    }
  }
</script>
